# Скопируй в .env.local и поменяй при необходимости.

# Моки API в браузере (MSW): true — работаем без бэка.
VITE_API_MOCK=true

# Куда dev-сервер проксирует /api, когда моки выключены.
API_PROXY_TARGET=http://localhost:8080

# Ключ 2ГИС MapGL для карты (публичный, ограничьте по домену в кабинете 2ГИС). Пусто — карта не показывается.
VITE_2GIS_KEY=
